NODE_ENV=development
PORT=4003
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=mysql://exa_scorecard:exa_scorecard_dev@localhost:3306/exa_scorecard
LOG_LEVEL=info
TEMPORARY_ACTOR_USER_ID=1
KPI_POOL_BASE_URL=http://localhost:4002
KPI_POOL_TIMEOUT_MS=5000
NATS_ENABLED=true
NATS_URL=nats://localhost:4222
NATS_NAME=exa-scorecards-service
NATS_STREAM=SCORECARD_EVENTS
NATS_SUBJECTS=scorecard.>
NATS_POOL_STREAM=EXA_KPI_POOL_EVENTS
NATS_POOL_CONSUMER=exa-scorecards-pool-events-v2
OUTBOX_PROCESSOR_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=25
OUTBOX_LOCK_TIMEOUT_MS=30000
OUTBOX_MAX_ATTEMPTS=10
