NODE_ENV=development
PORT=4002
CORS_ORIGIN=http://localhost:5173
# Host execution uses localhost. Docker Compose overrides this with host `mysql`.
DATABASE_URL=mysql://exa_kpi_pool:change_me@localhost:3306/exa_kpi_pool
KPI_MANAGEMENT_BASE_URL=http://localhost:4001
KPI_MANAGEMENT_TIMEOUT_MS=5000
LOG_LEVEL=info
NATS_ENABLED=true
NATS_URL=nats://localhost:4222
NATS_STREAM=EXA_KPI_POOL_EVENTS
NATS_SUBJECTS=kpi.pool.>
OUTBOX_PROCESSOR_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_LOCK_TIMEOUT_MS=300000
# Temporary nullable audit identity seam. Replace with EXA/JWT identity later.
TEMPORARY_ACTOR_USER_ID=1
