{
  "name": "exa-monitoring-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "cross-env RUN_MONITORING_INTEGRATION=true DATABASE_URL=mysql://exa_monitoring:exa_monitoring_dev@localhost:3306/exa_monitoring vitest run src/tests/result-entry.integration.test.ts src/tests/check-results.integration.test.ts src/tests/historical-baseline.integration.test.ts",
    "test:materialization": "cross-env RUN_MONITORING_MATERIALIZATION_SMOKE=true DATABASE_URL=mysql://exa_monitoring:exa_monitoring_dev@localhost:3306/exa_monitoring vitest run src/tests/monitoring-materialization.integration.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "ops:outbox": "tsx src/ops/outbox.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "multer": "^2.2.0",
    "nats": "^2.29.3",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.17.2",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^7.0.3",
    "prisma": "^6.14.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
